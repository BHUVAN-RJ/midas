{
  "id": "reminder-test",
  "name": "Reminder Test",
  "icon": {
    "symbol": "checklist",
    "background": "#FF9500",
    "backgroundDark": "#B36800"
  },
  "reads": [],
  "types": {
    "reminder:": {
      "$type": "reminder-test.item",
      "schema": {
        "type": "object",
        "required": [
          "title"
        ],
        "$defs": {
          "instant": {
            "type": "string",
            "format": "date-time"
          },
          "repeat": {
            "type": "object",
            "required": [
              "every"
            ],
            "properties": {
              "every": {
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month",
                  "year"
                ]
              },
              "interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "weekdays": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "until": {
                "$ref": "#/$defs/instant"
              }
            }
          }
        },
        "properties": {
          "$type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          },
          "list": {
            "type": "string",
            "maxLength": 200
          },
          "done": {
            "type": "boolean"
          },
          "timeZone": {
            "type": "string",
            "format": "time-zone"
          },
          "at": {
            "$ref": "#/$defs/instant"
          },
          "allDay": {
            "type": "boolean"
          },
          "repeat": {
            "$ref": "#/$defs/repeat"
          },
          "snoozedUntil": {
            "$ref": "#/$defs/instant"
          },
          "doneThrough": {
            "$ref": "#/$defs/instant"
          },
          "lastDoneAt": {
            "$ref": "#/$defs/instant"
          },
          "completedAt": {
            "$ref": "#/$defs/instant"
          },
          "createdAt": {
            "$ref": "#/$defs/instant"
          },
          "image": {
            "type": "string",
            "pattern": "^file:[A-Za-z0-9_-]{1,64}$"
          },
          "staple": {
            "type": "boolean"
          },
          "boughtAt": {
            "$ref": "#/$defs/instant"
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "externalId": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "list:": {
      "$type": "reminder-test.list",
      "schema": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "color": {
            "type": "string",
            "maxLength": 40
          },
          "icon": {
            "type": "string",
            "maxLength": 80
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "externalId": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "history:": {
      "$type": "reminder-test.history",
      "schema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "settings:": {
      "$type": "reminder-test.settings",
      "schema": {
        "type": "object",
        "properties": {
          "$type": {
            "type": "string"
          },
          "order": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "import:": {
      "$type": "reminder-test.import",
      "schema": {
        "type": "object",
        "required": [
          "source",
          "part",
          "parts"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "origin": {
            "type": "string",
            "maxLength": 80
          },
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string",
            "format": "time-zone"
          },
          "part": {
            "type": "integer",
            "minimum": 0
          },
          "parts": {
            "type": "integer",
            "minimum": 1
          },
          "lists": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "reminders": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "agent": {
    "description": "Everyday to-dos and reminders, with own lists (groceries, work, errands). Reminders can have a date, a time and a repeat, or none.",
    "rules": [
      "One reminder per request.",
      "A reminder is named by its title; copy it from the reminders listed. Two reminders that fit the words: do not act.",
      "Lists are named by their own names; built-in views (Today, Next 7 Days, Scheduled, Unscheduled, All, Past Due, Completed) are not lists, but can be moved in the sidebar.",
      "Import from Apple Reminders runs only on the page.",
      "Snooze is only on a notification, not a voice action."
    ],
    "notFor": [
      "Medicine, doses, water, injections, appointments and meetings someone is caring for: the care Sidekick, when the user has one.",
      "Questions about what is due (the page shows it)."
    ],
    "examples": [
      "Remind me to call Mom tomorrow at 6",
      "Add bananas to groceries",
      "Mark call the plumber as done",
      "Make milk a staple",
      "I didn't finish the report, untick it",
      "Delete the dentist reminder",
      "Move pay rent to my bills list",
      "Change call Mom to Friday at 5",
      "Make a new list called Travel",
      "Put my Work list at the top"
    ],
    "tools": [
      {
        "name": "reminder-test.add",
        "description": "Add a reminder, with a date, time, repeat and list when said.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "notes",
            "list",
            "when"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "The thing to do, in the person's words, without the reminder, when or list words. First letter capital."
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "description": "Extra detail the person asked to note, else null."
            },
            "list": {
              "type": [
                "string",
                "null"
              ],
              "description": "The list named, as listed, else null."
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/when"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "$defs": {
            "repeat": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "every",
                "interval",
                "weekdays"
              ],
              "properties": {
                "every": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ]
                },
                "interval": {
                  "type": "integer",
                  "description": "The N in every N weeks; 1 if not said."
                },
                "weekdays": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2,
                      3,
                      4,
                      5,
                      6
                    ]
                  },
                  "description": "Days named for a weekly repeat, 0 = Sunday; else []."
                }
              }
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "description": "The when words, copied as said. Midas works out the date; never do date arithmetic.",
              "required": [
                "whenKind",
                "minutesFromNow",
                "daysFromNow",
                "date",
                "yearMissing",
                "weekday",
                "weekdayNext",
                "time",
                "ampmStated",
                "partOfDay",
                "repeat",
                "whenText"
              ],
              "properties": {
                "whenKind": {
                  "type": "string",
                  "enum": [
                    "none",
                    "relative",
                    "absolute"
                  ]
                },
                "minutesFromNow": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "daysFromNow": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "YYYY-MM-DD"
                },
                "yearMissing": {
                  "type": "boolean"
                },
                "weekday": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "enum": [
                    0,
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    null
                  ]
                },
                "weekdayNext": {
                  "type": "boolean"
                },
                "time": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "HH:MM, 24-hour, as said"
                },
                "ampmStated": {
                  "type": "boolean"
                },
                "partOfDay": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "morning",
                    "afternoon",
                    "evening",
                    "tonight",
                    null
                  ]
                },
                "repeat": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/repeat"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "whenText": {
                  "type": "string"
                }
              }
            }
          }
        },
        "_meta": {
          "midas/when": "when",
          "midas/page-actions": [
            "new-reminder",
            "tail-tap"
          ]
        }
      },
      {
        "name": "reminder-test.edit",
        "description": "Change a reminder's title, notes or time, take its date away, or make it a staple (stays on its list when checked off, with the day it was bought) or not.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "title",
            "notes",
            "when",
            "clearDate",
            "staple"
          ],
          "properties": {
            "item": {
              "type": "string",
              "description": "The reminder's title, copied from the reminders listed for this Sidekick."
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "description": "The new title, else null."
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "description": "The new notes, else null."
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/when"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clearDate": {
              "type": "boolean",
              "description": "True only when the person asked to take the date off."
            },
            "staple": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "True to make it a staple, false to stop; else null."
            }
          },
          "$defs": {
            "repeat": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "every",
                "interval",
                "weekdays"
              ],
              "properties": {
                "every": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ]
                },
                "interval": {
                  "type": "integer",
                  "description": "The N in every N weeks; 1 if not said."
                },
                "weekdays": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2,
                      3,
                      4,
                      5,
                      6
                    ]
                  },
                  "description": "Days named for a weekly repeat, 0 = Sunday; else []."
                }
              }
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "description": "The when words, copied as said. Midas works out the date; never do date arithmetic.",
              "required": [
                "whenKind",
                "minutesFromNow",
                "daysFromNow",
                "date",
                "yearMissing",
                "weekday",
                "weekdayNext",
                "time",
                "ampmStated",
                "partOfDay",
                "repeat",
                "whenText"
              ],
              "properties": {
                "whenKind": {
                  "type": "string",
                  "enum": [
                    "none",
                    "relative",
                    "absolute"
                  ]
                },
                "minutesFromNow": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "daysFromNow": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "YYYY-MM-DD"
                },
                "yearMissing": {
                  "type": "boolean"
                },
                "weekday": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "enum": [
                    0,
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    null
                  ]
                },
                "weekdayNext": {
                  "type": "boolean"
                },
                "time": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "HH:MM, 24-hour, as said"
                },
                "ampmStated": {
                  "type": "boolean"
                },
                "partOfDay": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "morning",
                    "afternoon",
                    "evening",
                    "tonight",
                    null
                  ]
                },
                "repeat": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/repeat"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "whenText": {
                  "type": "string"
                }
              }
            }
          }
        },
        "_meta": {
          "midas/when": "when",
          "midas/page-actions": [
            "info",
            "swipe-details",
            "det-toggle-staple"
          ]
        }
      },
      {
        "name": "reminder-test.move",
        "description": "Move a reminder to another list, or out of its list.",
        "_meta": {
          "midas/page-actions": [
            "info",
            "swipe-details"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "list"
          ],
          "properties": {
            "item": {
              "type": "string",
              "description": "The reminder's title, copied from the reminders listed for this Sidekick."
            },
            "list": {
              "type": [
                "string",
                "null"
              ],
              "description": "The list to move it to, as listed; null to take it out of its list."
            }
          }
        }
      },
      {
        "name": "reminder-test.complete",
        "description": "Mark a reminder done (a repeat: its current time; a staple: bought today, it stays on its list).",
        "_meta": {
          "midas/page-actions": [
            "toggle-done"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string",
              "description": "The reminder's title, copied from the reminders listed for this Sidekick."
            }
          }
        }
      },
      {
        "name": "reminder-test.uncomplete",
        "description": "Mark a completed reminder not done.",
        "_meta": {
          "midas/page-actions": [
            "toggle-done"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string",
              "description": "The reminder's title, copied from the reminders listed for this Sidekick."
            }
          }
        }
      },
      {
        "name": "reminder-test.delete",
        "description": "Delete a reminder.",
        "_meta": {
          "midas/page-actions": [
            "swipe-delete"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string",
              "description": "The reminder's title, copied from the reminders listed for this Sidekick."
            }
          }
        }
      },
      {
        "name": "reminder-test.create_list",
        "description": "Make a new list.",
        "_meta": {
          "midas/page-actions": [
            "add-list"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "color",
            "icon"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "color": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "red",
                "orange",
                "yellow",
                "green",
                "cyan",
                "blue",
                "indigo",
                "pink",
                "purple",
                "brown",
                "gray",
                "mint",
                null
              ]
            },
            "icon": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "list",
                "bookmark",
                "cart",
                "person",
                "star",
                "house",
                "heart",
                "briefcase",
                "airplane",
                "car",
                "pill",
                "dumbbell",
                "leaf",
                "music",
                "book",
                "fork",
                "dollar",
                "gift",
                "moon",
                "sun",
                "paw",
                "gradcap",
                "clock",
                "tray",
                null
              ]
            }
          }
        }
      },
      {
        "name": "reminder-test.move_list",
        "description": "Move a list in the sidebar.",
        "_meta": {
          "midas/page-actions": [
            "saveSidebarOrderTask"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list",
            "position",
            "other"
          ],
          "properties": {
            "list": {
              "type": "string",
              "description": "The list or built-in view to move."
            },
            "position": {
              "type": "string",
              "enum": [
                "first",
                "last",
                "before",
                "after"
              ]
            },
            "other": {
              "type": [
                "string",
                "null"
              ],
              "description": "For before or after: the list it goes next to, else null."
            }
          }
        }
      }
    ]
  },
  "repair": {
    "keep": [
      "Completed items are packed many to a record in `history:<nnnn>` (`items`), never one record each.",
      "Every item, dated or not, is a `reminder:` record (an undated one has no `at`), and its text is `notes`.",
      "`import:` records and the shell's `request:` records are the Apple Reminders import handshake with the shell: do not change them.",
      "Copies differ: some are trimmed for one person (founder, 2026-10-25). Never bring back something the copy left out unless the person asks for it.",
      "The widget (`widget:today`) is written by `RemindersWidget.widgetRecords()` when the page loads and the stored one differs; keep its plain stand-in."
    ]
  }
}
