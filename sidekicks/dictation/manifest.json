{
  "id": "dictation",
  "name": "Dictation",
  "icon": {
    "symbol": "waveform",
    "background": "#2E2E2E",
    "backgroundDark": "#1F1F1F"
  },
  "reads": [],
  "types": {
    "run:": {
      "$type": "dictation.run",
      "schema": {
        "type": "object",
        "required": [
          "at",
          "source",
          "raw",
          "cleaned",
          "cleanupMs",
          "firstCall"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "phrase",
              "spoken",
              "run-all",
              "keyboard"
            ]
          },
          "raw": {
            "type": "string",
            "maxLength": 4000
          },
          "cleaned": {
            "type": "string",
            "maxLength": 4000
          },
          "releaseToRawMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "cleanupMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "totalMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "firstCall": {
            "type": "boolean"
          },
          "modelStatus": {
            "type": "string",
            "maxLength": 120
          },
          "device": {
            "type": "string",
            "maxLength": 60
          },
          "ios": {
            "type": "string",
            "maxLength": 20
          },
          "build": {
            "type": "string",
            "maxLength": 20
          },
          "path": {
            "type": "string",
            "enum": [
              "skip",
              "rule",
              "light",
              "rewrite"
            ]
          },
          "trigger": {
            "type": "string",
            "maxLength": 30
          },
          "matched": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "gateMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 60000
          },
          "expect": {
            "type": "string",
            "enum": [
              "skip",
              "rule",
              "light",
              "rewrite"
            ]
          },
          "prewarmed": {
            "type": "boolean"
          },
          "thermal": {
            "type": "string",
            "enum": [
              "nominal",
              "fair",
              "serious",
              "critical"
            ]
          },
          "pointer": {
            "type": "string",
            "maxLength": 400
          },
          "pointerValid": {
            "type": "boolean"
          },
          "mic": {
            "type": "string",
            "enum": [
              "keyboard",
              "app",
              "apple"
            ]
          },
          "cleanup": {
            "type": "string",
            "enum": [
              "applied",
              "unchanged",
              "off",
              "text-changed",
              "empty",
              "context-lost"
            ]
          },
          "dictationEnd": {
            "type": "string",
            "enum": [
              "input-mode",
              "quiet",
              "keyboard-shown",
              "midas-key",
              "keyboard-hidden"
            ]
          }
        }
      }
    },
    "summary:": {
      "$type": "dictation.summary",
      "schema": {
        "type": "object",
        "required": [
          "runs"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "lastCleanupMs": {
            "type": "integer",
            "minimum": 0
          },
          "averageCleanupMs": {
            "type": "integer",
            "minimum": 0
          },
          "worstCleanupMs": {
            "type": "integer",
            "minimum": 0
          },
          "lastAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "paths": {
            "type": "object",
            "properties": {
              "skip": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "averageTotalMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "rule": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "averageTotalMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "light": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "averageTotalMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "rewrite": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "averageTotalMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "thermal": {
            "type": "object",
            "properties": {
              "nominal": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "fair": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "serious": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "critical": {
                "type": "object",
                "required": [
                  "runs",
                  "sharePercent"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          },
          "pointer": {
            "type": "object",
            "required": [
              "runs",
              "valid",
              "empty",
              "sharePercent"
            ],
            "properties": {
              "runs": {
                "type": "integer",
                "minimum": 0
              },
              "valid": {
                "type": "integer",
                "minimum": 0
              },
              "empty": {
                "type": "integer",
                "minimum": 0
              },
              "sharePercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "mics": {
            "type": "object",
            "properties": {
              "keyboard": {
                "type": "object",
                "required": [
                  "runs"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "app": {
                "type": "object",
                "required": [
                  "runs"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "apple": {
                "type": "object",
                "required": [
                  "runs"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "settings:": {
      "$type": "dictation.settings",
      "schema": {
        "type": "object",
        "required": [
          "fillers",
          "positionFillers",
          "corrections",
          "triggers",
          "lightInstruction"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "fillers": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "positionFillers": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "corrections": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "triggers": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "word",
                "instruction"
              ],
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 30
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          },
          "lightInstruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "capitalise": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "phrases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "object",
              "required": [
                "text",
                "expect"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "expect": {
                  "type": "string",
                  "enum": [
                    "skip",
                    "rule",
                    "light",
                    "rewrite"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "strongCues": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "weakCues": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "anchors": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "keyboardMic": {
            "type": "string",
            "enum": [
              "keyboard",
              "app",
              "keyboard-only",
              "apple"
            ]
          },
          "appleCleanup": {
            "type": "boolean"
          }
        }
      }
    },
    "probe:": {
      "$type": "dictation.probe",
      "schema": {
        "type": "object",
        "required": [
          "at",
          "result",
          "fullAccess",
          "build",
          "ios"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string",
            "enum": [
              "works",
              "failed"
            ]
          },
          "step": {
            "type": "string",
            "enum": [
              "session-category",
              "activate",
              "engine-start",
              "audio",
              "recogniser"
            ]
          },
          "errorDomain": {
            "type": "string",
            "maxLength": 120
          },
          "errorCode": {
            "type": "integer"
          },
          "errorMessage": {
            "type": "string",
            "maxLength": 400
          },
          "fullAccess": {
            "type": "boolean"
          },
          "microphone": {
            "type": "string",
            "maxLength": 20
          },
          "speech": {
            "type": "string",
            "maxLength": 20
          },
          "build": {
            "type": "string",
            "maxLength": 20
          },
          "ios": {
            "type": "string",
            "maxLength": 20
          },
          "buffers": {
            "type": "integer",
            "minimum": 0
          },
          "peak": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "log:": {
      "$type": "dictation.log",
      "schema": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "$type": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "entries": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "at",
                "event",
                "detail"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "event": {
                  "type": "string",
                  "maxLength": 40
                },
                "detail": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  },
  "agent": {
    "description": "TEST Sidekick for the dictation cleanup test: timings of cleanup runs saved by the Midas Test app, each with the path the gate chose (skip, rule, light or rewrite), the phone heat, whether the model session was prewarmed, on light runs the words the model pointer named and whether they fit, and, for test phrases, the path expected; and the gate settings (fillers, strong and weak correction cues, anchors, trigger words, the light instruction, the capitalise list, the test phrases and how many times Run All repeats them); where the Midas keyboard records (keyboard mic: in the keyboard, falling back to the app switch; the app switch; keyboard only, never the app switch; or Apple's own dictation, which the keyboard watches and cleans up when Apple cleanup is on); which microphone recorded each keyboard run; one probe per keyboard attempt at the microphone (works or failed, the failed step and the exact error); and the keyboard log, the Midas keyboard's last 50 steps.",
    "rules": [
      "Runs are saved by the Dictation Test screen in the Midas Test app; nothing here adds or changes a run.",
      "Times are in milliseconds. A first call loads the model and is slower than a warm call; a prewarmed call had its instruction read before it was timed.",
      "Average and worst are over every saved run. Per-path numbers count only runs the gate decided; heat shares count only runs that logged the phone's heat (nominal, fair, serious, critical).",
      "Paths: skip inserts the text with no model call; rule removes fillers or applies a correction by rule with no model call (a number, time, day or month said again; after a strong cue, the words from an anchor word said again, or one word swapped for the last word before the cue); light asks the model which words before the cue the correction replaces, and the code replaces them (nothing the model writes is inserted); rewrite follows a trigger word said first (none by default).",
      "Changing settings: send only the lists, instructions or numbers to change; null keeps the current value. Lists replace the whole list, so include the existing entries to keep.",
      "Test phrases are what the Dictation Test screen offers and Run All runs, each with the path it should take; a run whose path differs counts as a wrong path. Run All runs each phrase the repeat number of times (1 to 20).",
      "Strong cues (scratch that, no wait) let the rules act; weak cues (actually, sorry) are often normal words, so only the model pointer looks at them. A cue with no words before it is not a correction. Pointer valid means the named words ended right before the cue, or none were named and the text stayed as said.",
      "Keyboard mic: keyboard tries the microphone inside the Midas keyboard and falls back to the app switch when it fails; app switch always opens Midas Test for the microphone; keyboard only uses the keyboard's microphone and never opens Midas Test, showing the exact error when it fails. A keyboard run's mic says which microphone recorded it. Probes and the keyboard log are saved by the Midas Test app; nothing here adds or changes them.",
      "Apple dictation: the person taps iOS's own microphone under the Midas keyboard; the keyboard shows the words, then removes fillers from what Apple typed when Apple cleanup is on (the default). An Apple Mic run says whether it was cleaned up or why not (the text changed, no words, the cursor moved, cleanup off) and how the dictation ended."
    ],
    "notFor": [
      "Dictating or cleaning up text.",
      "Notes, messages or reminders."
    ],
    "examples": [
      "How fast is dictation cleanup?",
      "What was the worst cleanup time?",
      "Show the last 5 dictation runs",
      "How often does dictation skip the model?",
      "How hot was the phone during the dictation runs?",
      "What are the dictation trigger words?",
      "Add hmm and er to the dictation fillers",
      "Add a test phrase: meet Sam on friday, expect skip",
      "Run each dictation phrase 5 times",
      "How often was the dictation pointer valid?",
      "Add hold on to the strong dictation cues",
      "Use the app switch for keyboard dictation",
      "What did the Midas keyboard do?",
      "Use only the keyboard mic for dictation",
      "Use Apple's dictation in the Midas keyboard",
      "Turn off Apple dictation cleanup"
    ],
    "tools": [
      {
        "name": "dictation.summary",
        "description": "The number of runs, the last, average and worst cleanup time in ms, per path (skip, rule, light, rewrite) the runs, share and average total ms, the share of runs per heat state, how many light runs had a valid model pointer, and how many test phrase runs took a wrong path, and keyboard runs per microphone (keyboard, app or apple).",
        "_meta": {
          "midas/page-actions": [
            "show-summary"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      },
      {
        "name": "dictation.runs",
        "description": "The latest runs, newest first: raw text, cleaned text and timings; on Apple dictation runs, whether the keyboard cleaned them up.",
        "_meta": {
          "midas/page-actions": [
            "show-all-runs"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limit"
          ],
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many runs, 1 to 50, when said; else null for 10."
            }
          }
        }
      },
      {
        "name": "dictation.settings",
        "description": "The gate settings: fillers, fillers by position, strong and weak correction cues, anchors, trigger words with their instructions, the light instruction, the capitalise list, the test phrases and how many times Run All repeats each, and where the Midas keyboard records (keyboard mic), and whether it cleans up Apple's dictation (apple cleanup).",
        "_meta": {
          "midas/page-actions": [
            "show-settings"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      },
      {
        "name": "dictation.save_settings",
        "description": "Changes the gate's settings. Each field replaces the current one; null keeps it.",
        "_meta": {
          "midas/page-actions": [
            "save-settings"
          ]
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fillers",
            "positionFillers",
            "strongCues",
            "weakCues",
            "anchors",
            "triggers",
            "lightInstruction",
            "capitalise",
            "phrases",
            "repeat",
            "keyboardMic",
            "appleCleanup"
          ],
          "properties": {
            "fillers": {
              "type": [
                "array",
                "null"
              ],
              "description": "Words or phrases always removed as fillers, the whole list; else null.",
              "items": {
                "type": "string"
              }
            },
            "positionFillers": {
              "type": [
                "array",
                "null"
              ],
              "description": "Fillers only at a sentence start, by a comma or next to another filler (like, so), the whole list; else null.",
              "items": {
                "type": "string"
              }
            },
            "strongCues": {
              "type": [
                "array",
                "null"
              ],
              "description": "Correction cues the rules may act on (scratch that, no wait), the whole list; else null.",
              "items": {
                "type": "string"
              }
            },
            "weakCues": {
              "type": [
                "array",
                "null"
              ],
              "description": "Correction cues that are often normal words (actually, sorry), only for the model pointer, the whole list; else null.",
              "items": {
                "type": "string"
              }
            },
            "anchors": {
              "type": [
                "array",
                "null"
              ],
              "description": "Small words (the, to, at) that start a correction said again, the whole list; else null.",
              "items": {
                "type": "string"
              }
            },
            "triggers": {
              "type": [
                "array",
                "null"
              ],
              "description": "Trigger words said first and the rewrite instruction for each, the whole list; else null.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "word",
                  "instruction"
                ],
                "properties": {
                  "word": {
                    "type": "string",
                    "description": "The word, e.g. email."
                  },
                  "instruction": {
                    "type": "string",
                    "description": "What the model does with the rest of the text."
                  }
                }
              }
            },
            "lightInstruction": {
              "type": [
                "string",
                "null"
              ],
              "description": "The light path instruction: the model names the words a correction replaces, one line, no examples; else null."
            },
            "capitalise": {
              "type": [
                "array",
                "null"
              ],
              "description": "Words written with this spelling when no cleanup runs (days, months), the whole list; else null.",
              "items": {
                "type": "string"
              }
            },
            "phrases": {
              "type": [
                "array",
                "null"
              ],
              "description": "Test phrases for the Dictation Test screen, the whole list; else null.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "expect",
                  "note"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The phrase as dictated."
                  },
                  "expect": {
                    "type": "string",
                    "enum": [
                      "skip",
                      "rule",
                      "light",
                      "rewrite"
                    ],
                    "description": "The path it should take."
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "What it tests, when said; else null."
                  }
                }
              }
            },
            "repeat": {
              "type": [
                "integer",
                "null"
              ],
              "description": "How many times Run All runs each test phrase, 1 to 20, when said; else null."
            },
            "keyboardMic": {
              "type": [
                "string",
                "null"
              ],
              "description": "Where the Midas keyboard records: keyboard (the microphone in the keyboard, the app switch when it fails), app (the app switch), keyboard-only (the keyboard's microphone, never the app switch) or apple (Apple's own dictation, cleaned up by the keyboard), when said; else null."
            },
            "appleCleanup": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the Midas keyboard cleans up what Apple's dictation typed (removes fillers), when said; else null."
            }
          }
        }
      },
