{
  "id": "hydration",
  "name": "Water",
  "icon": { "symbol": "drop.fill", "background": "#30D5C8", "backgroundDark": "#1E8C84" },
  "reads": [],
  "types": {
    "water:": {
      "$type": "hydration.day",
      "schema": {
        "type": "object",
        "required": ["ml"],
        "properties": {
          "$type": { "type": "string" },
          "ml": { "type": "number", "minimum": 0, "maximum": 100000 },
          "goalMl": { "type": "integer", "minimum": 1, "maximum": 20000 },
          "entries": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["at", "ml"],
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "ml": { "type": "integer", "minimum": 1, "maximum": 5000 }
              }
            }
          }
        }
      }
    },
    "settings:": {
      "$type": "hydration.settings",
      "schema": {
        "type": "object",
        "properties": {
          "$type": { "type": "string" },
          "goalMl": { "type": "integer", "minimum": 500, "maximum": 6000 },
          "unit": { "type": "string", "enum": ["ml", "l", "oz"] },
          "presetsMl": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 1, "maximum": 3000 }
          },
          "remindStart": { "type": "string", "format": "wall-time" },
          "remindEnd": { "type": "string", "format": "wall-time" },
          "everyHours": { "type": "integer", "enum": [2, 3, 4] },
          "remindersOn": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "page.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "text.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "page.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "accent.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "sea.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "sea.show": { "type": "boolean" },
          "streak.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "streak.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "streak.show": { "type": "boolean" },
          "drop.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "help.show": { "type": "boolean" },
          "amount.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "amount.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "goal.show": { "type": "boolean" },
          "presets.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "presets.textColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "presets.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "presets.show": { "type": "boolean" },
          "week.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "week.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "week.show": { "type": "boolean" },
          "nextLine.show": { "type": "boolean" },
          "bottom.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "bottom.show": { "type": "boolean" },
          "headings.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "headings.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "dates.format": {
  "type": "string",
  "enum": ["auto", "day-month", "month-day", "day-month-year", "month-day-year", "weekday-day-month", "weekday-month-day", "numeric-day-first", "numeric-month-first"]
}
        }
      }
    },
    "reminder:": {
      "$type": "hydration.reminder",
      "schema": {
        "type": "object",
        "required": ["title", "at"],
        "$defs": {
          "instant": { "type": "string", "format": "date-time" }
        },
        "properties": {
          "$type": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "notes": { "type": "string", "maxLength": 500 },
          "at": { "$ref": "#/$defs/instant" },
          "timeZone": { "type": "string", "format": "time-zone" },
          "done": { "type": "boolean" },
          "repeat": {
            "type": "object",
            "required": ["every"],
            "properties": {
              "every": { "type": "string", "enum": ["day"] }
            }
          },
          "everyHours": { "type": "integer", "enum": [2, 3, 4] },
          "endTime": { "type": "string", "format": "wall-time" },
          "listen": {
            "type": "object",
            "required": ["key", "field"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 200 },
              "field": { "type": "string", "minLength": 1, "maxLength": 80 },
              "goal": { "type": "string", "maxLength": 200 },
              "dayGoalField": { "type": "string", "maxLength": 80 },
              "quietMinutes": { "type": "integer", "minimum": 0, "maximum": 720 }
            }
          },
          "slotsDone": { "type": "object", "additionalProperties": { "$ref": "#/$defs/instant" } },
          "snoozedUntil": { "$ref": "#/$defs/instant" },
          "snoozes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/instant" } },
          "doneThrough": { "$ref": "#/$defs/instant" },
          "lastDoneAt": { "$ref": "#/$defs/instant" },
          "completedAt": { "$ref": "#/$defs/instant" },
          "createdAt": { "$ref": "#/$defs/instant" }
        }
      }
    }
  },
  "agent": {
    "description": "Drinking water: log a drink, see today's total against the daily goal and the streak, change the goal, the unit (ml, L or oz) and the reminders to drink.",
    "rules": [
      "One drink per log. An amount without a unit is in the unit the user has set.",
      "A glass with no amount said is the user's first preset.",
      "Undo takes back the latest drink logged today.",
      "Remove takes one drink off today or an earlier day: the latest, the latest of the amount said, or what the widget added.",
      "Reminders run every 2, 3 or 4 hours between two whole hours."
    ],
    "notFor": [
      "Food, coffee counts or other drinks tracked on their own.",
      "Medical advice."
    ],
    "examples": [
      "I drank 500 ml",
      "Had a glass of water",
      "Log 16 oz",
      "Undo that",
      "Remove the 500 ml from yesterday",
      "How much water today?",
      "Set my goal to 3 litres",
      "Show ounces",
      "Remind me every 3 hours from 8 to 8",
      "Stop the water reminders"
    ],
    "tools": [
      {
        "name": "hydration.log",
        "description": "Log a drink of water.",
        "_meta": { "midas/page-actions": ["log-preset", "log-custom"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "unit"],
          "properties": {
            "amount": {
              "type": ["number", "null"],
              "description": "The amount said, as a number; null for a glass with no amount."
            },
            "unit": {
              "type": ["string", "null"],
              "enum": ["ml", "l", "oz", null],
              "description": "ml, l (litres) or oz when said, else null."
            }
          }
        }
      },
      {
        "name": "hydration.undo",
        "description": "Take back the latest drink logged today.",
        "_meta": { "midas/page-actions": ["undo"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      },
      {
        "name": "hydration.remove",
        "description": "Remove one drink from today or an earlier day.",
        "_meta": { "midas/page-actions": ["remove-entry", "remove-widget-amount"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "amount", "unit", "fromWidget"],
          "properties": {
            "date": { "type": ["string", "null"], "description": "The day as YYYY-MM-DD; null for today." },
            "amount": { "type": ["number", "null"], "description": "The amount of the drink to remove, as a number; null for the latest drink." },
            "unit": { "type": ["string", "null"], "enum": ["ml", "l", "oz", null], "description": "ml, l (litres) or oz when said, else null." },
            "fromWidget": { "type": ["boolean", "null"], "description": "true to remove what the widget added that day, else null." }
          }
        }
      },
      {
        "name": "hydration.today",
        "description": "Today's total, the goal and the streak.",
        "_meta": { "midas/page-actions": ["show-today"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      },
      {
        "name": "hydration.set_goal",
        "description": "Change the daily goal.",
        "_meta": { "midas/page-actions": ["set-goal", "start"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "unit"],
          "properties": {
            "amount": {
              "type": "number",
              "description": "The goal said, as a number."
            },
            "unit": {
              "type": ["string", "null"],
              "enum": ["ml", "l", "oz", null],
              "description": "ml, l (litres) or oz when said, else null."
            }
          }
        }
      },
      {
        "name": "hydration.set_unit",
        "description": "Show amounts in ml, litres or ounces.",
        "_meta": { "midas/page-actions": ["set-unit"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit"],
          "properties": {
            "unit": {
              "type": "string",
              "enum": ["ml", "l", "oz"]
            }
          }
        }
      },
      {
        "name": "hydration.set_reminders",
        "description": "Turn the reminders to drink on or off, or change their hours.",
        "_meta": { "midas/page-actions": ["toggle-reminders", "set-remind-from", "set-remind-to", "set-every"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["on", "from", "to", "everyHours"],
          "properties": {
            "on": {
              "type": ["boolean", "null"],
              "description": "true to turn on, false to turn off, null when not said."
            },
            "from": {
              "type": ["string", "null"],
              "description": "First reminder, HH:00, 24-hour, when said, else null."
            },
            "to": {
              "type": ["string", "null"],
              "description": "Last reminder, HH:00, 24-hour, when said, else null."
            },
            "everyHours": {
              "type": ["integer", "null"],
              "enum": [2, 3, 4, null],
              "description": "Every 2, 3 or 4 hours when said, else null."
            }
          }
        }
      },
      {
        "name": "hydration.set_setting",
        "description": "Change how the page looks: a part's colour or size, show or hide a part, the date format.",
        "_meta": { "midas/page-actions": ["drawSettings"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": {
              "type": "string",
              "enum": [
                "page.colour",
                "text.colour",
                "page.size",
                "accent.colour",
                "sea.colour",
                "sea.show",
                "streak.colour",
                "streak.size",
                "streak.show",
                "drop.colour",
                "help.show",
                "amount.colour",
                "amount.size",
                "goal.show",
                "presets.colour",
                "presets.textColour",
                "presets.size",
                "presets.show",
                "week.colour",
                "week.size",
                "week.show",
                "nextLine.show",
                "bottom.size",
                "bottom.show",
                "headings.size",
                "headings.colour",
                "dates.format"
              ],
              "description": "The setting, from the list."
            },
            "value": {
              "type": "string",
              "description": "A colour as #RRGGBB; a size s, m, l or xl; on or off to show or hide; a date format such as day-month or month-day-year; else one of the setting's choices."
            }
          }
        }
      }
    ]
  },
  "repair": {
    "keep": [
      "`water:<YYYY-MM-DD>` `ml` is the day's total and the truth. A widget tap (an `increment` on `water:{today}`) adds to `ml` and nothing else, so `ml` can be more than the sum of `entries`; the page shows the difference as \"From widget\". Never rewrite `ml` from `entries`.",
      "Any write to today's `water:` record silences the reminders for 45 minutes (the `listen` of `reminder:water`). Write it only when the person logs, removes or undoes a drink, never on open, on a timer or to tidy up.",
      "`reminder:water` is the one reminder, written by the page from the settings: a daily `repeat` at `remindStart`, `everyHours` (2, 3 or 4), `endTime` (`remindEnd`) and `listen: { key: 'water:{today}', field: 'ml', goal: 'settings:main.goalMl', dayGoalField: 'goalMl', quietMinutes: 45 }`. Keep that shape.",
      "Each day record keeps its own `goalMl`, so a goal change never rewrites past streaks.",
      "All amounts are stored in ml; the unit (`ml`, `l` or `oz`) changes only what is shown (1 oz = 29.5735 ml).",
      "Keep the \"Widget\" button in Today's bottom bar (shown only until the widget is placed) and the request it writes. `widget:week` is retired: the page deletes it."
    ]
  },
  "settings": {
    "entries": [
      { "key": "page.colour", "label": "Background colour", "type": "colour", "part": "page", "selector": ":root", "css": "--sand", "default": "#F4EEE3" },
      { "key": "text.colour", "label": "Text colour", "type": "colour", "part": "text", "selector": ":root", "css": "--ink", "default": "#24343A" },
      { "key": "page.size", "label": "Size of everything on the page", "type": "size", "part": "page", "selector": "#main", "default": "m" },
      { "key": "accent.colour", "label": "Main button and switch colour", "type": "colour", "part": "accent", "selector": ":root", "css": "--accent", "default": "#2F7E87" },
      {
        "key": "sea.colour",
        "label": "Sea (the rising water) colour",
        "type": "colour",
        "part": "sea",
        "selector": ":root",
        "css": ["--sea-top", "--sea-bottom", "--sea-back"],
        "default": "#5E9FA8"
      },
      { "key": "sea.show", "label": "Sea (the rising water)", "type": "show", "part": "sea", "selector": "#sea", "default": true },
      { "key": "streak.colour", "label": "Streak (days in a row) colour", "type": "colour", "part": "streak", "selector": ".streak-chip", "css": "color", "default": "#24343A" },
      { "key": "streak.size", "label": "Streak (days in a row) size", "type": "size", "part": "streak", "selector": ".streak-chip", "default": "m" },
      { "key": "streak.show", "label": "Streak (days in a row)", "type": "show", "part": "streak", "selector": ".streak-chip", "default": true },
      {
        "key": "drop.colour",
        "label": "Water drop icon colour",
        "type": "colour",
        "part": "drop",
        "selector": ".streak-chip svg, .first .mark",
        "css": "color",
        "default": "#6FAFB6"
      },
      { "key": "help.show", "label": "Help (?) button", "type": "show", "part": "help", "selector": ".help", "default": true },
      { "key": "amount.colour", "label": "Today's amount colour", "type": "colour", "part": "amount", "selector": ".amount .big", "css": "color", "default": "#24343A" },
      { "key": "amount.size", "label": "Today's amount size", "type": "size", "part": "amount", "selector": ".amount .big", "default": "m" },
      { "key": "goal.show", "label": "Goal line under the amount", "type": "show", "part": "goal", "selector": ".amount .of", "default": true },
      { "key": "presets.colour", "label": "Amount buttons colour", "type": "colour", "part": "presets", "selector": ".preset", "css": "background-color", "default": "#FFFFFF" },
      { "key": "presets.textColour", "label": "Amount buttons text colour", "type": "colour", "part": "presets", "selector": ".preset", "css": "color", "default": "#24343A" },
      { "key": "presets.size", "label": "Amount buttons size", "type": "size", "part": "presets", "selector": ".presets", "default": "m" },
      { "key": "presets.show", "label": "Amount buttons", "type": "show", "part": "presets", "selector": ".presets", "default": true },
      { "key": "week.colour", "label": "Week rings colour", "type": "colour", "part": "week", "selector": ":root", "css": "--day-ring", "default": "#24535A" },
      { "key": "week.size", "label": "Week rings size", "type": "size", "part": "week", "selector": ".week", "default": "m" },
      { "key": "week.show", "label": "Week rings", "type": "show", "part": "week", "selector": ".week", "default": true },
      { "key": "nextLine.show", "label": "Next reminder line", "type": "show", "part": "next-line", "selector": ".next-line", "default": true },
      { "key": "bottom.size", "label": "Log and Settings buttons size", "type": "size", "part": "bottom", "selector": ".bottom", "default": "m" },
      { "key": "bottom.show", "label": "Log and Settings buttons", "type": "show", "part": "bottom", "selector": ".bottom", "default": true },
      { "key": "headings.size", "label": "Headings size", "type": "size", "part": "headings", "selector": ".h1, .lab", "default": "m" },
      { "key": "headings.colour", "label": "Headings colour", "type": "colour", "part": "headings", "selector": ".h1, .lab", "css": "color", "default": "#24343A" },
      { "key": "dates.format", "label": "Date format", "type": "dateFormat", "part": "dates", "default": "auto" }
    ]
  }
}
