                }
              }
            }
          }
        },
        "_meta": {
          "midas/when": "when",
          "midas/page-actions": ["edit-reminder"]
        }
      },
      {
        "name": "care-reminders.complete",
        "description": "Mark a reminder done: this dose, this appointment.",
        "_meta": { "midas/page-actions": ["done"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string",
              "description": "The reminder's title, copied from the reminders listed for this Sidekick."
