{
  "id": "care-reminders",
  "name": "Reminders",
  "icon": { "symbol": "pills.fill", "background": "#9CAF88", "backgroundDark": "#5E6B52" },
  "reads": [],
  "types": {
    "reminder:": {
      "$type": "care.item",
      "schema": {
        "type": "object",
        "required": ["title", "at"],
        "$defs": {
          "instant": { "type": "string", "format": "date-time" },
          "repeat": {
            "type": "object",
            "required": ["every"],
            "properties": {
              "every": { "type": "string", "enum": ["day", "week", "month", "year"] },
              "interval": { "type": "integer", "minimum": 1, "maximum": 999 },
              "weekdays": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 6 } },
              "until": { "$ref": "#/$defs/instant" }
            }
          },
          "alert": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 40 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 40 },
              "days": { "type": "integer", "minimum": 1, "maximum": 14 },
              "minutes": { "type": "integer", "minimum": 1 },
              "time": { "type": "string", "format": "wall-time" },
              "text": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "properties": {
          "$type": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "at": { "$ref": "#/$defs/instant" },
          "timeZone": { "type": "string", "format": "time-zone" },
          "done": { "type": "boolean" },
          "list": { "type": "string", "maxLength": 200 },
          "repeat": { "$ref": "#/$defs/repeat" },
          "everyHours": { "type": "integer", "enum": [2, 3, 4] },
          "reminderType": { "type": "string", "enum": ["normal", "timeSensitive", "alarm"] },
          "alerts": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/alert" } },
          "alertsDone": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 40 } },
          "slotsDone": { "type": "object", "additionalProperties": { "$ref": "#/$defs/instant" } },
          "snoozedUntil": { "$ref": "#/$defs/instant" },
          "snoozes": { "type": "object", "propertyNames": { "type": "string", "pattern": "^(~.{1,40}|@[0-9]{4})$" }, "additionalProperties": { "$ref": "#/$defs/instant" } },
          "doneThrough": { "$ref": "#/$defs/instant" },
          "lastDoneAt": { "$ref": "#/$defs/instant" },
          "completedAt": { "$ref": "#/$defs/instant" },
          "createdAt": { "$ref": "#/$defs/instant" }
        }
      }
    },
    "list:": {
      "$type": "care.list",
      "schema": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "$type": { "type": "string" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "icon": { "type": "string", "maxLength": 80 },
          "color": { "type": "string", "maxLength": 40 },
          "alerts": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "kind": { "type": "string", "minLength": 1, "maxLength": 40 },
                "days": { "type": "integer", "minimum": 1, "maximum": 14 },
                "minutes": { "type": "integer", "minimum": 1 },
                "time": { "type": "string", "format": "wall-time" },
                "text": { "type": "string", "maxLength": 200 }
              }
            }
          },
          "order": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "settings:": {
      "$type": "care.settings",
      "schema": {
        "type": "object",
        "properties": {
          "$type": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "page.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "text.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "greyText.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "page.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "title.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "title.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "title.show": { "type": "boolean" },
          "count.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "count.show": { "type": "boolean" },
          "tiles.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "tileNames.show": { "type": "boolean" },
          "doneButton.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "doneButton.textColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "newList.show": { "type": "boolean" },
          "today.show": { "type": "boolean" },
          "sectionLabels.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "sectionLabels.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "reminderNames.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "reminderNames.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "reminderTimes.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "reminderTimes.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "icons.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "icons.textColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "icons.show": { "type": "boolean" },
          "ring.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "ring.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "overdue.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "overdue.textColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "overdue.show": { "type": "boolean" },
          "done.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "done.textColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "doneReminders.show": { "type": "boolean" },
          "listHeader.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "alertRuler.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "alertRuler.show": { "type": "boolean" },
          "addReminder.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "addReminder.textColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "addReminder.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "addReminder.show": { "type": "boolean" },
          "buttons.size": { "type": "string", "enum": ["s", "m", "l", "xl"] },
          "delete.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "undoBar.colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "undoBar.textColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "dates.format": {
  "type": "string",
  "enum": ["auto", "day-month", "month-day", "day-month-year", "month-day-year", "weekday-day-month", "weekday-month-day", "numeric-day-first", "numeric-month-first"]
}
        }
      }
    }
  },
  "agent": {
    "description": "Caring for someone or yourself: medicine and doses, injections, water, appointments and meetings, in lists. Every reminder has a list, a day and a time; lists can carry early alerts.",
    "rules": [
      "One reminder per request.",
      "Every new reminder goes in a list: pick the list that fits (pills go in Medicine) from the lists listed.",
      "A reminder is named by its title; copy it from the reminders listed. Two reminders that fit the words: do not act.",
      "Done means this dose or this appointment, now.",
      "Snooze is only on a notification, not a voice action."
    ],
    "notFor": [
      "Everyday to-dos, shopping and errands: the Reminders Sidekick, when the user has one.",
      "Medical advice."
    ],
    "examples": [
      "Remind me to give Mom her pills at 8 every morning",
      "Gave Dad his insulin",
      "Water every 2 hours from 9",
      "Dentist appointment on Friday at 10",
      "Move the eye exam to Monday at 3",
      "Undo the pills",
      "Delete the physio appointment",
      "Make a list called Physio",
      "Add a reminder 2 days before for appointments"
    ],
    "tools": [
      {
        "name": "care-reminders.add",
        "description": "Add a reminder to a list, with its day, time and repeat.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "list",
            "when",
            "everyHours"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "What to do, in the person's words, without the when words. First letter capital."
            },
            "list": {
              "type": "string",
              "description": "The list it goes in, as listed."
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/when"
                },
                {
                  "type": "null"
                }
              ]
            },
            "everyHours": {
              "type": [
                "integer",
                "null"
              ],
              "enum": [
                2,
                3,
                4,
                null
              ],
              "description": "Every 2, 3 or 4 hours when said, else null."
            }
          },
          "$defs": {
            "repeat": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "every",
                "interval",
                "weekdays"
              ],
              "properties": {
                "every": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ]
                },
                "interval": {
                  "type": "integer",
                  "description": "The N in every N weeks; 1 if not said."
                },
                "weekdays": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2,
                      3,
                      4,
                      5,
                      6
                    ]
                  },
                  "description": "Days named for a weekly repeat, 0 = Sunday; else []."
                }
              }
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "description": "The when words, copied as said. Midas works out the date; never do date arithmetic.",
              "required": [
                "whenKind",
                "minutesFromNow",
                "daysFromNow",
                "date",
                "yearMissing",
                "weekday",
                "weekdayNext",
                "time",
                "ampmStated",
                "partOfDay",
                "repeat",
                "whenText"
              ],
              "properties": {
                "whenKind": {
                  "type": "string",
                  "enum": [
                    "none",
                    "relative",
                    "absolute"
                  ]
                },
                "minutesFromNow": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "daysFromNow": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "YYYY-MM-DD"
                },
                "yearMissing": {
                  "type": "boolean"
                },
                "weekday": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "enum": [
                    0,
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    null
                  ]
                },
                "weekdayNext": {
                  "type": "boolean"
                },
                "time": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "HH:MM, 24-hour, as said"
                },
                "ampmStated": {
                  "type": "boolean"
                },
                "partOfDay": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "morning",
                    "afternoon",
                    "evening",
                    "tonight",
                    null
                  ]
                },
                "repeat": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/repeat"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "whenText": {
                  "type": "string"
                }
              }
            }
          }
        },
        "_meta": {
          "midas/when": "when",
          "midas/page-actions": ["new-reminder"]
        }
      },
