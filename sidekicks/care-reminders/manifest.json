        "name": "care-reminders.create_list",
        "description": "Make a new list.",
        "_meta": { "midas/page-actions": ["new-list"] },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "icon",
            "color"
          ],
          "properties": {
