{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midas-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Account deletion (founder, 2026-11-02): daily alert re-send and day-6 reminder (index.ts scheduled).
  "triggers": { "crons": ["0 15 * * *"] },
  // Make (2026-10-24): the founder's account, the only one that gets the Make inbox.
  "vars": { "MAKE_FOUNDER_USER_ID": "PrGgyZ7ZCO7mo3wKxuShcA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midas",
      "database_id": "3ac7646d-8c75-492c-b746-fc03c5f2c6f7"
    }
  ],
  "r2_buckets": [
    { "binding": "BUNDLES", "bucket_name": "midas-bundles" },
    // Sidekick files (2026-10-15, unified data rework): created by the founder before live.
    { "binding": "FILES", "bucket_name": "midas-files" }
  ],
  // Staging (2026-10-10): its own Worker, database and bucket. Use with --env staging.
  // Bindings are not inherited from the top level, so each is listed again here.
  "env": {
    "staging": {
      "name": "midas-api-staging",
      "triggers": { "crons": ["0 15 * * *"] },
      "vars": { "RP_ID": "midas-api-staging.midas-backend.workers.dev", "SERVE_TEST_APP": "true", "MAKE_FOUNDER_USER_ID": "9-GAkqjLqjvn6Hyr9-AbTg" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "midas-staging",
          "database_id": "afa6ac36-7732-4573-8351-f7883bea4547"
        }
      ],
      "r2_buckets": [
        { "binding": "BUNDLES", "bucket_name": "midas-bundles-staging" },
        { "binding": "FILES", "bucket_name": "midas-files-staging" }
      ]
    }
  }
}
