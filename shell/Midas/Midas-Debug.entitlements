<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/PropertyList-1.0.dtd">
<!--
  Debug builds only (2026-10-10, founder approved, to be undone later if needed).
  ?mode=developer makes iOS fetch the apple-app-site-association file straight from our
  servers instead of Apple's CDN, which was still answering 404. Needs Settings > Developer >
  Associated Domains Development on the phone. Release/TestFlight use Midas.entitlements.
  To undo: delete this file and the Debug CODE_SIGN_ENTITLEMENTS line in project.yml.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:midas-api.midas-backend.workers.dev?mode=developer</string>
		<string>webcredentials:midas-api-staging.midas-backend.workers.dev?mode=developer</string>
	</array>
</dict>
</plist>
